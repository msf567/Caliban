<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-windows</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>CALIBAN</RootNamespace>
        <AssemblyName>CALIBAN</AssemblyName>
        <OutputPath>..\Builds\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>dune.ico</ApplicationIcon>

        <!-- Prevents duplicate attribute errors if you keep Properties\AssemblyInfo.cs -->
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <!-- Configuration Properties -->
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <PlatformTarget>AnyCPU</PlatformTarget>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
    </PropertyGroup>

    <!-- NuGet Package References -->
    <ItemGroup>
        <PackageReference Include="Terminal.Gui" Version="1.17.1"/>
        <PackageReference Include="NStack.Core" Version="1.1.1"/>
    </ItemGroup>

    <!-- Direct DLL References -->
    <ItemGroup>
        <Reference Include="CSCore">
            <HintPath>..\..\vs_dev_lib\cscore\CSCore\bin\Release\CSCore.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Project References -->
    <!-- Resources (Treasures.dll) is loaded at runtime by Caliban.Core's TreasureManager, so it is
         no longer referenced here (avoids the build cycle with the embedded sub-program exes). -->
    <ItemGroup>
        <ProjectReference Include="..\Caliban\Caliban.csproj"/>
        <ProjectReference Include="..\DebugLog\DebugLog.csproj"/>
    </ItemGroup>

    <!-- Content & None -->
    <ItemGroup>
        <Content Include="ILMerge.props"/>
        <Content Include="ILMergeOrder.txt"/>
    </ItemGroup>

</Project>