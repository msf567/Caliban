+                    {
+                        sb.Append(",");
+                    }
+
+                    sb.AppendLine();
+                }
+            }
+
+            sb.AppendLine(propertyIndent + "],"); // Close Treasures array
+
+            // 5. Print ChildNodes array
+            sb.AppendLine(propertyIndent + "\"ChildNodes\": [");
