ved(mSocWorker, _bytes);\r\n            }\r\n        }\r\n\r\n        private void OnDisconnection(Socket _socket)\r\n        {\r\n            if (Disconnected != null)\r\n            {\r\n                Disconnected(_socket);\r\n            }\r\n        }\r\n\r\n        private void OnConnectionDropped(Socket _socket)\r\n        {\r\n            mSocWorker = null;\r\n            OnDisconnection(_socket);\r\n        }\r\n    }\r\n}
