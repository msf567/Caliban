<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Caliban.Graphics.GraphicsApplication">
    <!-- The overlay draws itself entirely in OpenGL, so no control theme is
         required; the Application only exists to host the transparent overlay
         window and own the classic-desktop lifetime. -->
    <Application.Styles />
</Application>
