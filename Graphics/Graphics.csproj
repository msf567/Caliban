<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Build as a Windows (GUI) executable so no console window spawns by
             default. A console is only attached at runtime when the "debug"
             launch parameter is present (see Program.cs). -->
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>Graphics</AssemblyName>
        <!-- Build straight into the output folder without the per-framework
             (e.g. "net10.0") subfolder that SDK projects add by default. -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RootNamespace>Caliban.Graphics</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutDir>..\Builds\</OutDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenTK" Version="4.9.4"/>
        <PackageReference Include="System.Text.Json" Version="10.0.11"/>
        <!-- Avalonia hosts the transparent overlay. The overlay is a transparent
             Avalonia window whose OpenGlControlBase renders into a surface that
             Avalonia composites through DWM - unlike a native GLFW fullscreen GL
             swapchain, it is never promoted to the GPU independent-flip / MPO
             present path that was making the overlay opaque. -->
        <PackageReference Include="Avalonia" Version="11.3.22"/>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.22"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Shaders\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Caliban\Caliban.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\Palettes\Rock\DESERT\palette.bmp"/>
        <EmbeddedResource Include="Assets\Palettes\Rock\DESERT\palette.bmp"/>
    </ItemGroup>

</Project>
